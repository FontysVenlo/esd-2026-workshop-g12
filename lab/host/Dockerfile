# The "victim host" image.
#
# This is a full Docker-in-Docker (DinD) engine. Inside the workshop it plays
# the role of "the host machine". Participants never attack their own laptop:
# every vulnerable container is launched by this engine, so a successful escape
# lands here, on this container's filesystem, where the flags live.
FROM docker:28-dind

# Tools the facilitator scripts need. util-linux gives us nsenter/lsblk/mount
# used by some of the reference solutions.
# socat fronts the engine socket on TCP :2375 for levels 3 and 6.
RUN apk add --no-cache bash util-linux e2fsprogs coreutils socat procps

# Plant the flags. Flags are generated by the facilitator scripts and written to the host's
# .flags directory, which is bind-mounted read-only at /flags inside the host (see docker-compose
COPY flags/ /flags/
RUN chmod 600 /flags/*.txt && chown root:root /flags/*.txt

# Facilitator scripts (launch a level, reset it, check a submission).
COPY host/scripts/ /opt/lab/
# Strip Windows CRLF line endings in case the repo was checked out on Windows
# (or downloaded as a zip) without .gitattributes being applied.
RUN sed -i 's/\r$//' /opt/lab/* && chmod +x /opt/lab/*.sh
